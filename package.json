{
	"name": "promptbench",
	"version": "1.0.0",
	"description": "Test AI prompts from the WordPress admin.",
	"keywords": [
		"wordpress",
		"wordpress-plugin"
	],
	"homepage": "https://github.com/ernilambar/promptbench",
	"bugs": {
		"url": "https://github.com/ernilambar/promptbench/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ernilambar/promptbench.git"
	},
	"license": "GPL-2.0-or-later",
	"author": "Nilambar Sharma",
	"main": "promptbench.php",
	"scripts": {
		"build": "vite build",
		"predeploy": "rimraf build deploy vendor && pnpm run build && pnpm run vendor",
		"deploy": "packtor",
		"format": "prettier \"**/*.{cjs,css,js,jsx,json,mjs}\" --write --log-level warn",
		"vendor": "composer install --no-dev --no-scripts -o",
		"version": "easy-replace-in-files"
	},
	"browserslist": "> 2%, last 2 versions, not dead",
	"devDependencies": {
		"@wordpress/prettier-config": "^4.52.0",
		"easy-replace-in-files": "^2.0.0",
		"packtor": "^2.0.0",
		"postcss": "^8.5.25",
		"postcss-nested": "^8.0.0",
		"postcss-preset-env": "^11.3.2",
		"prettier": "npm:wp-prettier@^3.0.3",
		"rimraf": "^6.1.3",
		"vite": "^8.2.0"
	},
	"packageManager": "pnpm@11.10.0",
	"engines": {
		"pnpm": ">=11"
	}
}
