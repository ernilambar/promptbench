{
  "name": "ernilambar/promptbench",
  "description": "Test AI prompts from the WordPress admin.",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0",
    "ernilambar/gitvise": "^1.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "ernilambar/coding-standard": "^2.0",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpcompatibility/php-compatibility": "^10",
    "slevomat/coding-standard": "^8",
    "wp-cli/i18n-command": "^3.0",
    "wp-cli/wp-cli": "^3.0",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Nilambar\\Promptbench\\": "app/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "format": "@php ./vendor/bin/phpcbf --report-full --report-summary",
    "lint": [
      "@lint-php",
      "@phpcs"
    ],
    "lint-php": "@php ./vendor/bin/parallel-lint -p php --colors --exclude .git --exclude vendor .",
    "mo": "./vendor/bin/wp i18n make-mo languages/",
    "phpcs": "@php ./vendor/bin/phpcs --report-full --report-summary",
    "po": "./vendor/bin/wp i18n update-po languages/promptbench.pot languages/",
    "pot": "./vendor/bin/wp i18n make-pot . --exclude=build,deploy,node_modules,vendor --headers='{\"POT-Creation-Date\":\"\"}'"
  }
}
